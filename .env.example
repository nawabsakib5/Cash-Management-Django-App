# Copy to .env for local development. Never commit the real .env.

# ── Core ──
# Leave empty locally (a throw-away dev key is used). REQUIRED in production:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
SITE_URL=http://localhost:8000

# ── Production only ──
# DJANGO_SETTINGS_MODULE=cashProject.settings.production
# DATABASE_URL=postgres://user:password@host:5432/dbname
# ALLOWED_HOSTS=cash.example.com
# CSRF_TRUSTED_ORIGINS=https://cash.example.com
# SECURE_HSTS_SECONDS=3600        # raise to 31536000 once HTTPS is verified

# ── Local database (optional) - SQLite is used when DB_NAME is empty ──
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── First admin (created by `manage.py create_default_admin`) ──
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Email (console backend is used locally when EMAIL_HOST_USER is empty) ──
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Login protection (defaults shown) ──
# LOGIN_MAX_ATTEMPTS=5            # failed logins per username+IP before lockout
# LOGIN_IP_MAX_ATTEMPTS=20        # failed logins per IP (any username) before lockout
# LOGIN_LOCKOUT_SECONDS=900       # lockout length and counting window
# SIGNUP_MAX_PER_HOUR=10          # sign-ups per IP
# TRUSTED_PROXY_COUNT=1           # reverse proxies in front of the app (production default 1)

# ── Redis (optional) - empty = in-memory channel layer + inline Celery tasks ──
REDIS_URL=

# ── Google Sheets sync ──
GOOGLE_SHEET_ID=
# Production: paste the whole service-account JSON on one line.
GOOGLE_CREDENTIALS_JSON=
# Local alternative: path to the JSON file (git-ignored).
# GOOGLE_CREDENTIALS_FILE=google_credentials.json